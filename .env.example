# SmartAPI app key: https://smartapi.angelone.in/new/apps
ANGEL_API_KEY=

# Angel One client code, for example A123456
ANGEL_CLIENT_CODE=

# Trading PIN used for SmartAPI login (not the 6-digit TOTP)
ANGEL_PIN=

# Base32 secret from the Angel One authenticator setup.
# The server generates a fresh 6-digit code from this on each login.
ANGEL_TOTP_SECRET=
